# Secretos de las edge functions. Los valores reales se guardan como secretos en Supabase/Lovable, nunca en git.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Paso 11 (explicaciones): clave de Google AI Studio, propia del paso 11 (el paso 2 usa la suya). GEMINI_MODEL y GEMINI_FALLBACK_MODELS son opcionales (por defecto gemini-3.5-flash-lite → gemini-flash-lite-latest → gemini-3.6-flash)
GEMINI_API_KEY_EXPLAIN=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
# Opcional: si no se usa el AI Gateway de Lovable (LOVABLE_API_KEY lo genera Lovable)
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=

# SOLO LOCAL (no es un secreto de Supabase): cadena del Session pooler para scripts/load_profiles.py
DATABASE_URL=
